<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.s2tn.SettingsController">

    <!-- Top Bar -->
    <top>
        <HBox spacing="16" styleClass="glass-card header-bar">
            <padding>
                <Insets bottom="12" left="16" right="16" top="12" />
            </padding>

            <Button fx:id="btnBack" onAction="#onBack" styleClass="btn-secondary" text="Back" />

            <Label styleClass="node-title" text="Settings" />

            <Pane HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- Settings Content -->
    <center>
        <VBox alignment="TOP_LEFT" spacing="20">
            <padding>
                <Insets bottom="16" left="20" right="20" top="16" />
            </padding>

            <!-- AUDIO / ACCESSIBILITY -->
            <VBox prefWidth="600" spacing="8" styleClass="glass-card">
                <padding>
                    <Insets bottom="16" left="14" right="14" top="16" />
                </padding>

                <Label styleClass="node-title" text="Audio and Accessibility" />

                <!-- Volume Slider (GUI-only for now) -->
                <HBox spacing="10">
                    <Label text="Master Volume" />
                    <Slider fx:id="sliderMasterVolume" prefWidth="300" value="75" />
                </HBox>

                <!-- Text-to-Speech toggle (backed by Speak class) -->
                <CheckBox fx:id="chkTextToSpeech" text="Enable Text-to-Speech" />
            </VBox>
         <VBox prefHeight="66.0" prefWidth="600.0" styleClass="glass-card">
            <children>
               <Label prefHeight="17.0" prefWidth="124.0" text="Account" />
               <Button fx:id="btnResetData" mnemonicParsing="false" onAction="#onReset" prefHeight="25.0" prefWidth="110.0" text="Reset Data" />
               <Button fx:id="btnExportData" mnemonicParsing="false" onAction="#onExport" prefHeight="25.0" prefWidth="110.0" text="Export Data" />
               <Button fx:id="btnDeleteAccount" mnemonicParsing="false" onAction="#onDelete" prefHeight="25.0" prefWidth="110.0" text="Delete Account" />
            </children>
         </VBox>

            <!-- ABOUT -->
            <VBox prefWidth="600" spacing="6" styleClass="stat-card">
                <Label styleClass="node-title" text="About" />
                <Label text="Escape Room Software - Version 1.0.0" />
                <Label text="Developed by S2TN" />
            </VBox>
        </VBox>
    </center>

</BorderPane>
