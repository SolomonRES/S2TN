<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.s2tn.GuestMapController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-bar">
            <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>

            <VBox alignment="CENTER_LEFT">
                <Label styleClass="header-title" text="Dungeon Map"/>
                <Label styleClass="header-subtitle" text="Choose your adventure"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button fx:id="statusPill" styleClass="status-pill" text="Loading..."/>

            <Button fx:id="btnInventory" onAction="#onInventoryClicked" styleClass="icon-btn">
                <graphic>
                    <ImageView fitHeight="22" fitWidth="22" preserveRatio="true" styleClass="stat-icon">
                        <image><Image url="@com/s2tn/assets/moneyBagEmoji.png"/></image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnSettings" onAction="#onSettingsClicked" styleClass="icon-btn">
                <graphic>
                    <ImageView fitHeight="22" fitWidth="22" preserveRatio="true" styleClass="stat-icon">
                        <image><Image url="@com/s2tn/assets/gearEmoji.png"/></image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnLogout" onAction="#onLogoutClicked" styleClass="icon-btn-red">
                <graphic>
                    <ImageView fitHeight="22" fitWidth="22" preserveRatio="true" styleClass="stat-icon">
                        <image><Image url="@com/s2tn/assets/doorEmoji.png"/></image>
                    </ImageView>
                </graphic>
            </Button>

        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="20">
                    <padding><Insets bottom="30" left="30" right="30" top="30"/></padding>

                    <!-- STAT CARDS -->
                    <HBox spacing="20">

                        <VBox alignment="CENTER" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true" styleClass="stat-icon">
                                <image><Image url="@com/s2tn/assets/mapEmoji.png"/></image>
                            </ImageView>
                            <Label styleClass="card-label" text="Total Dungeons"/>
                            <Label fx:id="totalDungeonsLabel" styleClass="card-value-blue" text="-"/>
                        </VBox>

                        <VBox alignment="CENTER" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true" styleClass="stat-icon">
                                <image><Image url="@com/s2tn/assets/checkEmoji.png"/></image>
                            </ImageView>
                            <Label styleClass="card-label" text="Completed"/>
                            <Label fx:id="completedLabel" styleClass="card-value-green" text="0"/>
                        </VBox>

                        <VBox alignment="CENTER" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true" styleClass="stat-icon">
                                <image><Image url="@com/s2tn/assets/targetEmoji.png"/></image>
                            </ImageView>
                            <Label styleClass="card-label" text="Remaining"/>
                            <Label fx:id="remainingLabel" styleClass="card-value-orange" text="-"/>
                        </VBox>

                    </HBox>

                    <!-- MAP CONTAINER -->
                    <StackPane styleClass="map-container" prefWidth="1000" prefHeight="500">

                        <!-- BACKGROUND MAP -->
                        <ImageView fx:id="mapImage"
                                   fitWidth="1000"
                                   fitHeight="500"
                                   preserveRatio="false"
                                   styleClass="map-image"/>

                        <!-- OVERLAY -->
                        <Pane fx:id="mapOverlay">

                            <!-- LEVEL 1 -->
                            <VBox alignment="CENTER" layoutX="450" layoutY="275" spacing="5">
                                <Button fx:id="btnLevel1" onAction="#onLevel1Clicked" styleClass="map-node-btn">
                                    <graphic>
                                        <ImageView fx:id="imgLevel1" fitHeight="56" fitWidth="56" preserveRatio="true"
                                                   styleClass="map-node-graphic">
                                            <image><Image url="@com/s2tn/assets/fireEmoji.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <VBox alignment="CENTER" styleClass="node-label-box">
                                    <Label fx:id="lblLevel1Name" styleClass="node-title" text="Loading..."/>
                                    <Label fx:id="lblLevel1Diff" styleClass="node-subtitle" text="Hard"/>
                                </VBox>
                            </VBox>

                            <!-- LEVEL 2 -->
                            <VBox alignment="CENTER" layoutX="650" layoutY="120" spacing="5">
                                <Button fx:id="btnLevel2" onAction="#onLevel2Clicked" styleClass="map-node-btn">
                                    <graphic>
                                        <ImageView fx:id="imgLevel2" fitHeight="56" fitWidth="56" preserveRatio="true"
                                                   styleClass="map-node-graphic">
                                            <image><Image url="@com/s2tn/assets/moneyBagEmoji.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <VBox alignment="CENTER" styleClass="node-label-box">
                                    <Label fx:id="lblLevel2Name" styleClass="node-title" text="Loading..."/>
                                    <Label fx:id="lblLevel2Diff" styleClass="node-subtitle" text="Intermediate"/>
                                </VBox>
                            </VBox>

                            <!-- LEVEL 3 -->
                            <VBox alignment="CENTER" layoutX="900" layoutY="180" spacing="5">
                                <Button fx:id="btnLevel3" onAction="#onLevel3Clicked" styleClass="map-node-btn">
                                    <graphic>
                                        <ImageView fx:id="imgLevel3" fitHeight="56" fitWidth="56" preserveRatio="true"
                                                   styleClass="map-node-graphic">
                                            <image><Image url="@com/s2tn/assets/tombEmoji.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <VBox alignment="CENTER" styleClass="node-label-box">
                                    <Label fx:id="lblLevel3Name" styleClass="node-title" text="Locked"/>
                                    <Label fx:id="lblLevel3Diff" styleClass="node-subtitle" text="---"/>
                                </VBox>
                            </VBox>

                        </Pane>

                        <!-- LEGEND -->
                        <VBox spacing="6" styleClass="glass-card"
                              maxHeight="-Infinity" maxWidth="-Infinity"
                              StackPane.alignment="BOTTOM_LEFT">
                            <StackPane.margin><Insets bottom="20" left="20"/></StackPane.margin>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Map Legend"/>

                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                    <image><Image url="@com/s2tn/assets/mapLegendAvailable.png"/></image>
                                </ImageView>
                                <Label text="Available"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                    <image><Image url="@com/s2tn/assets/mapLegendCompleted.png"/></image>
                                </ImageView>
                                <Label text="Completed"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                    <image><Image url="@com/s2tn/assets/mapLegendLocked.png"/></image>
                                </ImageView>
                                <Label text="Locked"/>
                            </HBox>

                        </VBox>

                        <!-- USER CARD -->
                        <HBox spacing="10" styleClass="glass-card"
                              maxHeight="-Infinity" maxWidth="-Infinity"
                              StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin><Insets right="20" top="20"/></StackPane.margin>

                            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                                <image><Image url="@com/s2tn/assets/playerAvatar.png"/></image>
                            </ImageView>

                            <VBox>
                                <Label fx:id="userNameLabel"
                                       style="-fx-font-weight: bold; -fx-text-fill: #333;"
                                       text="Guest"/>
                                <Label fx:id="userRoleLabel"
                                       style="-fx-text-fill: gray; -fx-font-size: 10px;"
                                       text="Adventurer"/>
                            </VBox>
                        </HBox>

                    </StackPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>